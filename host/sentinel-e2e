#!/bin/bash
# Sentinel End-to-End-Test vom Host (WSL, als root). Bootet eine WEGWERF-KOPIE der LFS-Platte, nie das Original:
#   1. Units + Baseline in der VM, Host pinnt den Stand ausserhalb der VM
#   2. sentinel-watch + sentinel-demo (Stoppuhr: rot <= 15 s) + TUI-Rauchtest im Pseudo-Terminal
#   3. F1-F8 per sentinel-selftest (Erkennung in der VM)
#   4. F9 Angreifer mit root: /usr/bin/ls aendern UND Baseline neu schreiben
#      -> VM selbst gruen (Grenze), Host-Vergleich (verify) und Offline-Pruefung der Platte erkennen es
# Exit 0 = alles wie erwartet, 1 = mindestens eine Erwartung verfehlt, 2 = Lauf nicht moeglich.
set -u
SRC=${SENTINEL_E2E_IMAGE:-/srv/lfs/lfs.img}
WORK=$(mktemp -d /srv/lfs/e2e.XXXXXX)
COPY=$WORK/disk.img; TRUST=$WORK/trust; SOCK=$WORK/serial.sock
VM=
ROWS=()
row() { ROWS+=("$(printf '%-4s %-22s %-9s %-5s %s' "$1" "$2" "$3" "$4" "$5")"); }
cleanup() {
  [ -n "$VM" ] && kill "$VM" 2>/dev/null && wait "$VM" 2>/dev/null
  rm -rf -- "$WORK"
}
trap cleanup EXIT
die() { echo "sentinel-e2e: $*" >&2; exit 2; }
waitssh() { for i in $(seq 1 60); do lfs-ssh -n true 2>/dev/null && return 0; sleep 2; done; return 1; }
vm() { lfs-ssh -n "$@"; }
start_vm() {
  lfs-vm --disk "$COPY" --headless "$SOCK" > "$WORK/qemu.log" 2>&1 &
  VM=$!
  waitssh || die "VM nicht per SSH erreichbar"
}
stop_vm() {
  vm 'sudo poweroff' 2>/dev/null
  for i in $(seq 1 60); do kill -0 "$VM" 2>/dev/null || break; sleep 1; done
  kill "$VM" 2>/dev/null; wait "$VM" 2>/dev/null; VM=
}

pgrep -x qemu-system-x86 >/dev/null && die "es laeuft schon eine VM (Port 2222), zuerst ausschalten"
command -v sentinel-host >/dev/null || die "sentinel-host fehlt (host/install-host.sh)"
T0=$(date +%s)
echo "=== Wegwerf-Kopie von $SRC"
cp --sparse=always "$SRC" "$COPY" || die "Kopie fehlgeschlagen"
start_vm
echo "=== VM: $(vm 'sentinel --version') | Units + Baseline"
vm 'sudo sh ~/sentinel/systemd/install.sh >/dev/null && sudo sentinel baseline' || die "Baseline in der VM fehlgeschlagen"
sentinel-host pin --trust "$TRUST" || die "pin fehlgeschlagen"
sentinel-host verify --trust "$TRUST" >/dev/null; rc=$?
[ $rc = 0 ] && row H0 "Host verify (sauber)" "OK" $rc PASS || row H0 "Host verify (sauber)" "-" $rc FAIL

echo "=== M4: sentinel-watch + Demo mit Stoppuhr + Dashboard"
vm 'sudo systemctl start sentinel-watch.service && sleep 4 && systemctl is-active sentinel-watch.service' >/dev/null   || die "sentinel-watch startet nicht"
D=$(vm 'sudo sentinel-demo' 2>&1); rc=$?
echo "$D"
[ $rc = 0 ] && row D1 "Demo (Stoppuhr)" "-" $rc PASS || row D1 "Demo (Stoppuhr)" "-" $rc FAIL
T=$(vm 'sudo python3 -I ~/sentinel/tools/tui_smoke.py' 2>&1); rc=$?
echo "$T"
[ $rc = 0 ] && row D2 "TUI im Pseudo-Terminal" "-" $rc PASS || row D2 "TUI im Pseudo-Terminal" "-" $rc FAIL

echo "=== F1-F8: sentinel-selftest in der VM"
J=$(vm 'sudo sentinel-selftest --json'); src=$?
[ -n "$J" ] || die "selftest lieferte nichts (exit $src)"
while IFS=$'\t' read -r id sev ex after res desc; do
  row "$id" "${desc:0:22}" "$sev" "$ex" "$res"
done < <(printf '%s' "$J" | python3 -I -c '
import json, sys
for r in json.load(sys.stdin):
    print("\t".join(str(r[k]) for k in ("id", "severity", "exit", "exit_after", "result", "desc")))')

echo "=== F9: root-Angreifer aendert /usr/bin/ls und schreibt die Baseline neu"
vm 'sudo sentinel-fault inject F1 >/dev/null && sudo sentinel baseline >/dev/null' || die "F9 nicht injizierbar"
vm 'sudo sentinel check >/dev/null'; rc=$?
# Erwartung: die VM ist hier blind (exit 0). Das ist die dokumentierte Grenze, kein Fehler des Tests.
[ $rc = 0 ] && row F9a "VM-check (blind)" "-" $rc "PASS*" || row F9a "VM-check (blind)" "?" $rc FAIL
OUT=$(sentinel-host verify --trust "$TRUST"); rc=$?
echo "$OUT" | grep -q '/usr/bin/ls' && [ $rc = 11 ] && row F9b "Host verify" CRIT $rc PASS || row F9b "Host verify" "-" $rc FAIL
stop_vm
OUT=$(sentinel-host offline --trust "$TRUST" --image "$COPY"); rc=$?
echo "$OUT" | grep -q 'CRIT  offline    /usr/bin/ls' && [ $rc = 11 ] && row F9c "Offline-Platte" CRIT $rc PASS \
  || { row F9c "Offline-Platte" "-" $rc FAIL; echo "$OUT" | tail -5; }

echo
printf '%-4s %-22s %-9s %-5s %s\n' ID Fehler erkannt exit Ergebnis
printf '%s\n' "${ROWS[@]}"
FAILS=$(printf '%s\n' "${ROWS[@]}" | grep -c 'FAIL$')
TOTAL=${#ROWS[@]}
echo "-- $((TOTAL - FAILS))/$TOTAL wie erwartet in $(( $(date +%s) - T0 )) s   (* = VM allein erkennt F9 nicht: genau dafuer gibt es den Host)"
[ "$FAILS" = 0 ] && exit 0 || exit 1
